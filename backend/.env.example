NODE_ENV=development
PORT=4000

# PostgreSQL connection string (Prisma format)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/routepool"

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# OTP
OTP_EXPIRY_MINUTES=5
ALLOWED_EMAIL_DOMAIN=spit.ac.in

# Database mode:
#   false = use real PostgreSQL via Prisma (default, requires Docker or local PG)
#   true  = use in-memory mock store (no database needed, data lost on restart)
USE_MOCK_DB=false

# Auto-rickshaw meter tariff (Mumbai auto rates)
AUTO_BASE_FARE=27
AUTO_BASE_KM=1.5
AUTO_PER_KM_RATE=18
AUTO_SURGE_MULTIPLIER=1.2

# Real OTP email (Gmail). Leave unset to just print the code in the server log.
# SMTP_PASS is a 16-character Google App Password, NOT your Gmail password.
SMTP_USER=
SMTP_PASS=
MAIL_FROM=RoutePool <youraccount@gmail.com>
