NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/routepool
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=5
ALLOWED_EMAIL_DOMAIN=spit.ac.in
# Auto-rickshaw meter tariff: AUTO_BASE_FARE for the first AUTO_BASE_KM, then
# AUTO_PER_KM_RATE per km beyond it, times AUTO_SURGE_MULTIPLIER for the driver.
AUTO_BASE_FARE=27
AUTO_BASE_KM=1.5
AUTO_PER_KM_RATE=18
AUTO_SURGE_MULTIPLIER=1.2
