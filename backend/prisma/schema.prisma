// RoutePool — Prisma Schema
// Mirrors db/init.sql exactly (same table names, column names, constraints).
// PostGIS geography column on nodes is declared Unsupported; all queries
// that need lat/lng or ST_DWithin use prisma.$queryRaw / prisma.$executeRaw.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums (match PostgreSQL enum types in init.sql)
// ─────────────────────────────────────────────────────────────────────────────

enum RideStatus {
  open
  matched
  completed
  cancelled

  @@map("ride_status")
}

enum GroupStatus {
  forming
  confirmed
  completed
  cancelled

  @@map("group_status")
}

enum MemberStatus {
  pending
  confirmed
  left

  @@map("member_status")
}

enum NodeArea {
  campus
  city

  @@map("node_area")
}

// ─────────────────────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  initials     String
  branch       String?
  is_verified  Boolean  @default(false)
  total_rides  Int      @default(0)
  total_savings Decimal @default(0) @db.Decimal(10, 2)
  // Permanent per-rider code handed to the driver at pickup (never rotates).
  rider_code    String?
  created_at   DateTime @default(now()) @db.Timestamptz()

  rideRequests RideRequest[]
  groupMembers GroupMember[]
  chatMessages ChatMessage[]

  @@map("users")
}

model OtpCode {
  id         String   @id @default(uuid()) @db.Uuid
  email      String
  code_hash  String
  expires_at DateTime @db.Timestamptz()
  consumed   Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz()

  @@index([email], name: "idx_otp_email")
  @@map("otp_codes")
}

// nodes has a PostGIS geography column (geom). Prisma doesn't support PostGIS
// natively, so we use Unsupported("geography(Point, 4326)") and all lat/lng
// extraction or proximity queries go through prisma.$queryRaw.
model Node {
  id         String                           @id @default(uuid()) @db.Uuid
  name       String
  short_name String
  area       NodeArea                         @default(city)
  geom       Unsupported("geography(Point, 4326)")
  created_at DateTime                         @default(now()) @db.Timestamptz()

  edgesAsA          RouteEdge[]   @relation("EdgeNodeA")
  edgesAsB          RouteEdge[]   @relation("EdgeNodeB")
  groups            Group[]
  rideRequestPickup RideRequest[] @relation("PickupNode")
  rideRequestDrop   RideRequest[] @relation("DropNode")
  groupMemberDrops  GroupMember[]

  @@map("nodes")
}

model RouteEdge {
  id          String  @id @default(uuid()) @db.Uuid
  node_a_id   String  @db.Uuid
  node_b_id   String  @db.Uuid
  distance_km Decimal @db.Decimal(6, 2)

  nodeA Node @relation("EdgeNodeA", fields: [node_a_id], references: [id], onDelete: Cascade)
  nodeB Node @relation("EdgeNodeB", fields: [node_b_id], references: [id], onDelete: Cascade)

  @@index([node_a_id], name: "idx_edges_a")
  @@index([node_b_id], name: "idx_edges_b")
  @@map("route_edges")
}

model Group {
  id             String      @id @default(uuid()) @db.Uuid
  pickup_node_id String      @db.Uuid
  departure_time DateTime    @db.Timestamptz()
  total_fare     Decimal     @default(0) @db.Decimal(8, 2)
  status         GroupStatus @default(forming)
  // 'auto' = pooled auto ride (Book a ride), 'transit' = public-transport group (Form a group)
  kind           String      @default("auto")
  meeting_point  String?
  transit_mode   String?
  created_at     DateTime    @default(now()) @db.Timestamptz()

  pickupNode   Node          @relation(fields: [pickup_node_id], references: [id])
  members      GroupMember[]
  chatMessages ChatMessage[]
  rideRequests RideRequest[]

  @@map("groups")
}

model RideRequest {
  id                   String     @id @default(uuid()) @db.Uuid
  user_id              String     @db.Uuid
  pickup_node_id       String     @db.Uuid
  drop_node_id         String     @db.Uuid
  window_start         DateTime   @db.Timestamptz()
  window_end           DateTime   @db.Timestamptz()
  flex_minutes         Int        @default(0)
  status               RideStatus @default(open)
  estimated_distance_km Decimal   @db.Decimal(6, 2)
  solo_fare            Decimal    @db.Decimal(8, 2)
  group_id             String?    @db.Uuid
  created_at           DateTime   @default(now()) @db.Timestamptz()

  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  pickupNode   Node          @relation("PickupNode", fields: [pickup_node_id], references: [id])
  dropNode     Node          @relation("DropNode", fields: [drop_node_id], references: [id])
  group        Group?        @relation(fields: [group_id], references: [id], onDelete: SetNull)
  groupMembers GroupMember[]

  @@index([status], name: "idx_ride_requests_status")
  @@index([user_id], name: "idx_ride_requests_user")
  @@index([pickup_node_id], name: "idx_ride_requests_pickup")
  @@map("ride_requests")
}

model GroupMember {
  id              String       @id @default(uuid()) @db.Uuid
  group_id        String       @db.Uuid
  user_id         String       @db.Uuid
  ride_request_id String       @db.Uuid
  drop_node_id    String       @db.Uuid
  fare_share      Decimal      @default(0) @db.Decimal(8, 2)
  status          MemberStatus @default(confirmed)
  // Set when the rider gave the driver their code: the ride has started for them.
  boarded_at      DateTime?  @db.Timestamptz()
  joined_at       DateTime     @default(now()) @db.Timestamptz()

  group       Group       @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  rideRequest RideRequest @relation(fields: [ride_request_id], references: [id], onDelete: Cascade)
  dropNode    Node        @relation(fields: [drop_node_id], references: [id])

  @@unique([group_id, user_id])
  @@map("group_members")
}

model ChatMessage {
  id         String   @id @default(uuid()) @db.Uuid
  group_id   String   @db.Uuid
  user_id    String   @db.Uuid
  message    String
  created_at DateTime @default(now()) @db.Timestamptz()

  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([group_id, created_at], name: "idx_chat_group")
  @@map("chat_messages")
}
